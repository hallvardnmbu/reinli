#55311=IFCPROPERTYSINGLEVALUE('Element ID',$,IFCLABEL('AF-D'),$);
#55309=IFCPROPERTYSINGLEVALUE('Arkeologiske funn',$,IFCLABEL('Knapp. Sirkul\X\E6rt papirstykke med litografi av den tronende Kristus. Del av sirkul\X\E6rt papirstykke med h\X\E5ndskrift, \X\E5rstallet 1841 kan leses. To fragmenter av vindusglass.  .'),$);
#55313=IFCPROPERTYSINGLEVALUE('Navn',$,IFCLABEL('Nest \X\F8stre nordfelt'),$);
#55303=IFCPROPERTYSINGLEVALUE('Arkeologiske funn',$,IFCLABEL('Diverse vindusglassfragmenter. Benperle. Knappen\X\E5l. Svovelkiskrystall. To fragmenter av papir med trykk, fremstiller grener med l\X\F8v; klebet p\X\E5 filt '),$);
